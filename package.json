{
  "name": "mudders",
  "private": true,
  "description": "Mudders: turn-based artillery on destructible terrain. Set the mud on fire.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mudders/client --filter @mudders/signal dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm content:validate && pnpm test",
    "verify": "pnpm check && pnpm bench && pnpm build && pnpm smoke && pnpm audio:preview && pnpm play:smoke && pnpm play:net && pnpm determinism:browsers",
    "smoke": "pnpm --filter @mudders/capture smoke",
    "setup:browsers": "bash scripts/setup-browsers.sh",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "determinism:browsers": "pnpm setup:browsers && pnpm --filter @mudders/capture determinism",
    "check:ffmpeg": "pnpm --filter @mudders/capture check:ffmpeg",
    "bench": "pnpm --filter @mudders/content bench",
    "content:validate": "pnpm --filter @mudders/content content:validate",
    "content:docs": "pnpm --filter @mudders/content content:docs",
    "content:new": "pnpm --filter @mudders/content content:new",
    "sim:preview": "pnpm --filter @mudders/capture sim:preview",
    "capture": "pnpm --filter @mudders/capture capture",
    "play:smoke": "pnpm --filter @mudders/capture play:smoke",
    "play:net": "pnpm --filter @mudders/capture play:net",
    "audio:preview": "pnpm --filter @mudders/capture audio:preview"
  },
  "browserslist": [
    "baseline 2026"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
