{
  "name": "@mudders/capture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless capture CLI: runs scenarios through the real renderer in headless Chromium (SwiftShader) and encodes GIF/MP4 with ffmpeg.",
  "scripts": {
    "smoke": "tsx src/cli/smoke.ts",
    "check:ffmpeg": "tsx src/cli/check-ffmpeg.ts",
    "determinism": "tsx src/cli/determinism.ts",
    "typecheck": "tsc -p .",
    "build": "tsc -p .",
    "sim:preview": "tsx ../../scripts/vite-run.ts src/cli/sim-preview.ts"
  },
  "dependencies": {
    "@mudders/content": "workspace:*",
    "@mudders/shared": "workspace:*",
    "@mudders/sim": "workspace:*",
    "playwright": "1.63.0",
    "vite": "^8.3.6"
  }
}
