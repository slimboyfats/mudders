  "meta": {
    "name": "Office Tower",
    "description": "A tall concrete office block with a roof mast, built in three sections. Each section soaks up hits on its own, cracks and then pours down as rubble, so the top can be shot off while the base still stands. Bring the base down and the whole tower follows. Each section's windows shatter at the first hit. A steel frame runs up its corners to the roof beam and the mast, so lightning on the roof shocks any tank leaning on the walls.",
    "since": "core@0.20.0"
  },
