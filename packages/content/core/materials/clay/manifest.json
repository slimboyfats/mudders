{
  "id": "material.clay",
  "schemaVersion": 1,
  "meta": {
    "name": "Clay",
    "description": "Dense, sticky ground that holds together in lumps. Water soaks it into soft wet clay; heat bakes the crater walls into hard brick, and fire or lava touching it fires it too.",
    "since": "core@0.21.0",
    "color": "#c98a52"
  },
  "cell": 38,
  "settle": "fall",
  "glide": 0.375,
  "density": 120,
  "strength": {
    "blast": 1.3,
    "kinetic": 1.2,
    "heat": 1.5,
    "shock": 1.2,
    "dig": 1.6,
    "corrosive": 8
  },
  "cohesion": 0.5,
  "eject": {
    "share": 0.3,
    "reach": 1.2
  },
  "coating": false,
  "reactions": [
    {
      "with": "material.water",
      "into": "material.wet-clay",
      "other": "air",
      "chance": 0.25
    },
    {
      "with": "material.fire",
      "into": "material.brick",
      "chance": 0.05
    },
    {
      "with": "material.lava",
      "into": "material.brick",
      "chance": 0.3
    }
  ],
  "rim": [
    {
      "damage": ["heat"],
      "into": "material.brick",
      "depth": 3
    }
  ]
}
