{
  "id": "material.ice",
  "schemaVersion": 1,
  "meta": {
    "name": "Ice",
    "description": "Frozen ground. Never falls and shrugs off blasts, but it is slippery: tanks slide down icy slopes. Blasts shatter the crater rim into loose ice shards, heat melts it into water, and fire or burning oil thaws whatever it touches.",
    "since": "core@0.3.0",
    "color": "#a9d8f0"
  },
  "cell": 4,
  "settle": "static",
  "density": 150,
  "strength": {
    "blast": 1.8,
    "kinetic": 1.5,
    "heat": 0.2,
    "shock": 2,
    "dig": 1.5,
    "corrosive": 4
  },
  "cohesion": 0,
  "coating": false,
  "reactions": [
    {
      "with": "material.fire",
      "into": "material.water",
      "chance": 0.2
    },
    {
      "with": "material.burning-oil",
      "into": "material.water",
      "chance": 0.1
    }
  ],
  "slick": {
    "ticks": 3
  },
  "rim": [
    {
      "damage": ["blast", "kinetic", "shock"],
      "into": "material.ice-shards",
      "depth": 4,
      "chance": 0.7
    },
    {
      "damage": ["heat"],
      "into": "material.water",
      "depth": 3
    }
  ]
}
