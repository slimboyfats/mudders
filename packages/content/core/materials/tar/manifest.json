    "color": "#1b181f"
  },
  "cell": 62,
  "settle": "slide",
  "density": 130,
  "strength": {
    "blast": 1.3,
    "kinetic": 2,
    "shock": 1.5,
    "dig": 0.8,
    "corrosive": 4
  },
  "cohesion": 0.4,
  "coating": false,
  "sticky": {
    "drive": 3
  },
  "reactions": [
