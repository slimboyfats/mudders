      "into": "material.burning-tar",
      "chance": 0.12
    },
    {
      "with": "material.napalm",
      "into": "material.burning-tar",
      "chance": 0.3
    },
    {
      "with": "material.lava",
      "into": "material.burning-tar",
      "chance": 0.3
    }
  ],
  "look": {
    "cycle": ["#1b181f", "#1b181f", "#1b181f", "#2a2533", "#3a3446", "#2a2533"],
    "cycleTicks": 12
  }
