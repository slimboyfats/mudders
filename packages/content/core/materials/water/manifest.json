{
  "id": "material.water",
  "schemaVersion": 1,
  "meta": {
    "name": "Water",
    "description": "Runs fast and levels out into pools and lakes that stay. Washes sand and ash away, turns the dirt it sits on to mud, puts out fire and quenches lava into rock, boiling off as steam where it touches anything hot. Gas bubbles up through it.",
    "since": "core@0.4.0",
    "color": "#3a78c8"
  },
  "cell": 19,
  "settle": "flow",
  "density": 50,
  "strength": {
    "blast": 0.4,
    "kinetic": 0.3,
    "heat": 0.5,
    "shock": 0.3,
    "dig": 0.2
  },
  "cohesion": -0.5,
  "coating": false,
  "tags": ["wet"],
  "reactions": [
    {
      "with": "material.lava",
      "into": "material.steam",
      "other": "material.rock",
      "chance": 0.6
    },
    {
      "with": "material.sand",
      "other": "material.liquid-dirt",
      "chance": 0.2
    },
    {
      "with": "material.ash",
      "other": "air",
      "chance": 0.2
    },
    {
      "with": "material.dirt",
      "other": "material.mud",
      "chance": 0.01
    },
    {
      "with": "#hot",
      "into": "material.steam",
      "chance": 0.05
    }
  ],
  "spread": 63,
  "disperse": 6,
  "look": {
    "cycle": ["#3a78c8", "#3a78c8", "#3470bc", "#4686d4", "#3a78c8"],
    "cycleTicks": 10
  }
}
