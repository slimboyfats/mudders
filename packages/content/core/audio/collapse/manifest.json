{
  "id": "audio.collapse",
  "schemaVersion": 1,
  "meta": {
    "name": "Collapse",
    "description": "A long rumble when a structure comes down.",
    "since": "core@0.9.0"
  },
  "bus": "sfx",
  "licence": {
    "spdx": "CC0-1.0",
    "author": "Mudders contributors",
