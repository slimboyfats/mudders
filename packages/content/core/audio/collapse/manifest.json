  },
  "synth": {
    "voices": [
      {
        "wave": "noise",
        "freq": 300,
        "to": 60,
        "hold": 0.3,
        "release": 0.9,
        "volume": 0.5
      },
      {
        "wave": "triangle",
        "freq": 55,
        "to": 30,
        "release": 1.0,
        "volume": 0.5
      }
